<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Full-screen, no title bar: the game draws its own chrome. -->
    <style name="GameTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">#FF05070D</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">#FF05070D</item>
        <item name="android:navigationBarColor">#FF05070D</item>
    </style>
</resources>
